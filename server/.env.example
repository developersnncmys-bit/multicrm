# Copy to server/.env and fill in. Never commit the real .env.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=nnc_crm
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
PORT=5000
# Comma-separated list of frontend URLs allowed to call the API
CLIENT_ORIGIN=http://localhost:5180,http://localhost:5181
# First admin account, created automatically when the users collection is empty
ADMIN_EMAIL=admin@nnc.in
ADMIN_PASSWORD=change-me
